# kintone（サーバー側のみで使用。ブラウザには一切渡らない）
KINTONE_BASE_URL=https://2dkyrf4gb7hv.cybozu.com
KINTONE_AUTH=（vis.rimiens@gmail.com:パスワード をBase64にした値）

# アプリID
KINTONE_APP_AGENCY=9
KINTONE_APP_ORDER=10
KINTONE_APP_REWARD=11
KINTONE_APP_PRODUCT=12
KINTONE_APP_DEMO=13
KINTONE_APP_LEAD=14
# お知らせ・資料の保存先（Supabase・未設定なら画面に「準備中」と出る）
# 公開可能キー（sb_publishable_...）のみ。秘密鍵（sb_secret_...）は絶対に書かない。
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 書き込み用（お知らせ・資料の登録／再発行申請の閲覧）。サーバー側のみで使う。
# ブラウザに渡らないよう、NEXT_PUBLIC_ を絶対に付けないこと。
SUPABASE_SECRET_KEY=

# 認証
AUTH_SECRET=（openssl rand -base64 32 で生成）
AUTH_TRUST_HOST=true

# 本部アカウント（代理店コードの代わりにこのIDでログインする）
HQ_LOGIN_ID=vis-hq
# ★ bcryptハッシュには $ が含まれる。Next.js が変数として展開してしまうため
#    必ず \$ のようにエスケープして書くこと（例: \$2b\$10\$xxxx...）
HQ_PASSWORD_HASH=（npm run hash -- 'パスワード' で生成し、$ を \$ に置換して貼る）

# JotForm・UTAGE からの受け口を守る合言葉
# openssl rand -hex 24 で作った長い文字列を入れる。
# JotForm と UTAGE の送信先URLに ?token=＜この値＞ を付ける。
WEBHOOK_TOKEN=

# メール送信（承認メール・獲得通知・採点依頼）
# Xserver の vis@metore0403.com を使う
SMTP_HOST=sv12025.xserver.jp
SMTP_PORT=465
SMTP_USER=vis@metore0403.com
SMTP_PASS=
MAIL_FROM=vis@metore0403.com
HQ_MAIL=

# 取次パートナー用ご紹介（トスアップ）フォームのURL。
# ビルド時に埋め込まれるため、設定後は必ず再デプロイする。
#
# 取次パートナーにお渡しするのは「共通の公式LINE」と「このフォーム」の2つだけ。
# ここが空のままだと、取次パートナーの画面に
# 「ご紹介フォームのURLがまだ設定されていません」と出たままになる。
#
# 本部で使っている共通トスアップフォーム（JotForm）のURLを入れる。
# 取次店コードを差し込みたい場所に {code} と書ける。
# {code} を書かないときは、末尾に ?agency_id=取次店コード を自動で付ける。
#   例: NEXT_PUBLIC_TOSS_FORM_URL=https://form.jotform.com/＜フォームID＞?agency_id={code}
#
# ★ フォーム側の受け取り欄（JotForm の「固有名」）は agency_id と完全一致させること。
#    一致していないと、どの取次パートナーからのご紹介か記録されない。
# ★ NEXT_PUBLIC_ で始まる値は、画面を組み立てるとき（ビルド時）に埋め込まれる。
#    Vercel では「環境変数を登録 → 再デプロイ（Redeploy）」まで行わないと反映されない。
NEXT_PUBLIC_TOSS_FORM_URL=
