# ═══════════════════════════════════════════════════════════
#  VIS 代理店ポータル ― 設定の一覧
#
#  このファイルは「何を設定する必要があるか」の控えです。
#  中身は本物ではありません（値はすべて例）。
#
#  ローカルで動かすとき  … このファイルを .env.local という名前でコピーして値を入れる
#  本番（Vercel）で使うとき … Vercel の Project Settings > Environment Variables に入れる
#
#  ★ Vercel の環境変数は「次に配置したものから」効きます。
#     値を変えたら、必ず再配置（Redeploy）してください。
#
#  ★ .env.local は git に入れないでください（.gitignore で除外済み）。
# ═══════════════════════════════════════════════════════════


# ── 保存先（Supabase）─ 無いと何も表示できません ──────────────
# Supabase の Project Settings > API から取得します。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# 秘密鍵。サーバー側だけで使います。
# ★ この鍵は全テーブルを読み書きできます。絶対に外に出さないでください。
# ★ NEXT_PUBLIC_ を付けないでください（付けると画面のコードに埋め込まれ、誰でも読めます）。
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# 公開鍵。いまは使っていませんが、控えとして。
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx


# ── ログイン ─ 無いとログインできません ─────────────────────
# セッションの署名に使う秘密の文字列。長いランダムな文字列にしてください。
# 作り方: openssl rand -base64 48
# ★ これを変えると、ログイン中の全員が一度ログアウトされます。
AUTH_SECRET=ここに長いランダムな文字列

# 本部のログインID
HQ_LOGIN_ID=ADM00

# 本部のパスワード（bcrypt でハッシュ化したもの。平文は入れません）
# 作り方: npx bcrypt-cli hash 'あなたのパスワード' 10
# ★ .env.local に書くときは $ を \$ にエスケープしてください（$ が変数として消えるため）。
#    Vercel に入れるときはエスケープ不要です。そのまま貼ってください。
HQ_PASSWORD_HASH=\$2b\$10\$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── 申込・決済の受け口 ─ 無いと JotForm と決済が繋がりません ──
# JotForm と UTAGE から呼ばれる URL に付ける合言葉。
# これが合わない通信は 401 で断ります。長いランダムな文字列にしてください。
# ★ 変えたら、JotForm 8フォームと UTAGE の Webhook URL も全部directory変更が必要です。
WEBHOOK_TOKEN=ここに長いランダムな文字列

# 設定する先の URL（参考）:
#   JotForm     https://＜このアプリのURL＞/api/webhooks/jotform?token=＜合言葉＞&kind=＜種類＞
#               kind に入れる値: agency / referrer / staff / lead / demo / pre-register / license-test
#   UTAGE・決済 https://＜このアプリのURL＞/api/webhooks/order?token=＜合言葉＞


# ── メール ─ 無くても動きますが、承認の案内が届きません ────────
# 独自ドメインのメールを使ってください。
# フリーメール（gmail 等）は UTAGE や Xserver で弾かれます。
SMTP_HOST=svxxxx.xserver.jp
SMTP_PORT=465
SMTP_USER=vis@metore0403.com
SMTP_PASS=ここにメールのパスワード

# 差出人。省略すると SMTP_USER と同じになります。
MAIL_FROM=vis@metore0403.com

# 本部が受け取るアドレス。ライセンステストの採点依頼などが届きます。
# 省略すると SMTP_USER と同じになります。
HQ_MAIL=vis@metore0403.com

# ★ 設定していない場合、承認しても画面に
#   「メールの送信設定（SMTP）がまだ入っていません。」と出ます。
#   承認そのものは成立します（メールだけが送られません）。


# ── URL ─ 省略できます ────────────────────────────────
# 承認メールに載せるマイページの URL。
# 省略すると Vercel の本番 URL が自動で使われるので、ふだんは不要です。
# 独自ドメインに変えたときだけ設定してください。
PORTAL_URL=https://vis-rimiens-system.vercel.app

# 取次パートナー用のご紹介フォーム（JotForm）の URL。
# 承認メールに載せます。NEXT_PUBLIC_ が付いているので画面側からも読めます
# （公開してよい URL なので問題ありません）。
NEXT_PUBLIC_TOSS_FORM_URL=https://form.jotform.com/xxxxxxxxxxxxx


# ── kintone（解約済み）─ もう不要です ──────────────────────
# 2026年8月に Supabase へ移行しました。接続コードは kintone.ts.unused に
# 退避してあり、動いていません。KINTONE_ で始まる設定は削除して構いません。

# Stripe（1年後の定期パッド配送の自動作成に使う）
# クレジットカードの受注が入った瞬間に、17,500円/年の定期（トライアル付き）を
# Stripe に作る。未設定でも受注は普通に入り、請求予定日だけが台帳に残る。
STRIPE_SECRET_KEY=
